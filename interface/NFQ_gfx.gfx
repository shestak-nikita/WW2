spriteTypes={
	# GFX_icon: Strip of icons for focus "+" buttons.
	# Frames: 0 = normal, 1 = hover shine, 2 = glow for available, 3 = glow hover.THAT WAS HOW IT WAS SUPPOSED TO BE BUT I GAVE UP
